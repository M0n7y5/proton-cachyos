Date: Fri, 21 Aug 2026 23:02:01 +0200
Subject: [PATCH 14/27] setupapi: Initialize the Service value size when
 checking for winehid devices.

---
 dlls/setupapi/devinst.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/dlls/setupapi/devinst.c b/dlls/setupapi/devinst.c
index 9cc1ba87f7b..3c505e84655 100644
--- a/dlls/setupapi/devinst.c
+++ b/dlls/setupapi/devinst.c
@@ -2265,6 +2265,7 @@ static BOOL is_device_instance_linked(HKEY subKey, HKEY interfacesKey, const WCH
     WCHAR alt_devinstance[MAX_DEVICE_ID_LEN];
     WCHAR service[40];
 
+    len = sizeof(service);
     l = RegQueryValueExW(subKey, L"Service", NULL, &type, (BYTE *)service, &len);
     if (!l && type == REG_SZ && !wcsicmp(service, L"winehid") && !wcsstr(deviceInstance, L"HID\\"))
     {
