From: M0n7y5 <17201053+M0n7y5@users.noreply.github.com>
Date: Tue, 11 Aug 2026 18:30:35 +0200
Subject: [PATCH 137/162] mmdevapi: Initialize the spatial sound option buffer
 before reading it.

---
 dlls/mmdevapi/spatialaudio.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/dlls/mmdevapi/spatialaudio.c b/dlls/mmdevapi/spatialaudio.c
index c849bcc5a50..2c6bd667a2a 100644
--- a/dlls/mmdevapi/spatialaudio.c
+++ b/dlls/mmdevapi/spatialaudio.c
@@ -54,7 +54,9 @@ static BOOL spatial_option_enabled(const WCHAR *value)
 
 static UINT get_spatial_dynamic_budget(void)
 {
-    WCHAR buf[16];
+    /* an over-long env value or an empty registry value leaves buf untouched
+     * while still reporting success */
+    WCHAR buf[16] = {0};
     DWORD size = sizeof(buf);
     HKEY key;
     BOOL enabled = FALSE;
