             mono_ns = (UINT64)ts.tv_sec * 1000000000 + ts.tv_nsec;
 
@@ -3589,6 +3869,16 @@ static void pipewire_period_timer_loop(void *args)
                 NtSetEvent(stream->event, NULL);
