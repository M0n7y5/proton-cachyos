Date: Sat, 13 Jun 2026 00:39:48 +0200
Subject: [PATCH 120/162] mmdevapi: Render dynamic spatial audio objects
 through Steam Audio when available.

(cherry picked from commit 1374264de60b5e33a3dd6896eaedca49d5efd438)
---
 dlls/mmdevapi/Makefile.in    |   5 +-
 dlls/mmdevapi/spatialaudio.c |  96 +++++++++-
 dlls/mmdevapi/unix/spatial.c | 341 +++++++++++++++++++++++++++++++++++
 dlls/mmdevapi/unix/unixlib.h |  83 +++++++++
 4 files changed, 520 insertions(+), 5 deletions(-)
 create mode 100644 dlls/mmdevapi/unix/spatial.c
 create mode 100644 dlls/mmdevapi/unix/unixlib.h

diff --git a/dlls/mmdevapi/Makefile.in b/dlls/mmdevapi/Makefile.in
